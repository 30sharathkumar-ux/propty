{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/vendor/three/(.*)", "dest": "/public/vendor/three/$1" },
    { "src": "/api/(.*)",          "dest": "/api/index.js" },
    { "src": "/healthz",           "dest": "/api/index.js" },
    { "src": "/(.*\\.(js|css|svg|png|ico|woff2?))", "dest": "/public/$1" },
    { "src": "/(.*)",              "dest": "/api/index.js" }
  ]
}
